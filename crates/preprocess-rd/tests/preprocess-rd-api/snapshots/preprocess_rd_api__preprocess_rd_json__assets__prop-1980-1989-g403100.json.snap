    <p>-t- 640000</p>
    <p>- 2000<br/> + 6000<br/> -1- 895000</p>
    <p>- 75000<br/> + 90000</p>
    <p>
      <b>10373000</b>
    </p>
    <p>
      <b>-1-1554000</b>
    </p>
