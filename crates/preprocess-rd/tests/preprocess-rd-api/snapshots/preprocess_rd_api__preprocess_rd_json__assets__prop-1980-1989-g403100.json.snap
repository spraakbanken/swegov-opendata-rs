    <p>Föredraganden</p>
    <p>15 329000</p>
    <p>+4671000</p>
    <p>-1600000</p>
    <p>(2000000)</p>
    <p>(-2000000)</p>
    <p>300000</p>
    <p>of.</p>
    <p>of.</p>
